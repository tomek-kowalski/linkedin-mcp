# Copy to .env and fill in locally. Never commit .env.
# Only the bin scripts (npm run auth, npm start) read this file; importing the library never does.
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
# The numeric id of the Company Page (urn:li:organization:<id>).
LINKEDIN_ORGANIZATION_ID=000000
# Exact LinkedIn-Version, YYYYMM. Versions are supported for at least a year; move forward before the sunset.
LINKEDIN_API_VERSION=202610
# Absolute path OUTSIDE this repository, e.g. next to the other private stores.
LINKEDIN_TOKEN_FILE=/absolute/path/outside/the/repo/linkedin-token.json
# Must be registered exactly like this in the app's Auth settings. Loopback only (the local auth flow listens here).
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Optional, space-separated. Default: r_organization_social w_organization_social rw_organization_admin
# LINKEDIN_SCOPES=r_organization_social w_organization_social rw_organization_admin
